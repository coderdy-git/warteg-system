datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed password
  name      String
  role      String   @default("owner") // "owner" | "kasir"
  createdAt DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  type        String   // "income" | "expense" | "transfer_in" | "transfer_out"
  amount      Int      // Jumlah uang (Rupiah)
  method      String   // "tunai_toko" | "tunai_kas_besar" | "qris_dana" | "qris_gopay"
  description String   // Keterangan transaksi
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([date(sort: Desc)])
  @@index([type, method])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
