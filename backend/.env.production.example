PORT=3001

# Supabase PostgreSQL Connection (Project: warteg system | Ref: vqwblfhfitbciiolicfq | Region: ap-south-1)
# Ganti [YOUR-DB-PASSWORD] dengan Database Password Supabase Anda

# Transaction Pooler (Port 6543) - Digunakan oleh aplikasi saat runtime
DATABASE_URL="postgresql://postgres.vqwblfhfitbciiolicfq:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session Pooler / Direct Connection (Port 5432) - Digunakan oleh Prisma CLI untuk migrasi
DIRECT_URL="postgresql://postgres.vqwblfhfitbciiolicfq:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Gunakan secret acak minimal 32 karakter di server production
JWT_SECRET="ganti-dengan-secret-key-production-yang-sangat-panjang-dan-acak"

# Batasi domain frontend yang diizinkan mengakses API di production (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN="https://wsystem.yourdomain.com"
